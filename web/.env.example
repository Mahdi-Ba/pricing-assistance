# Web app (backend-for-frontend) settings. Copy to .env.local for `npm run dev`.
# Origin of the pricing API (server-side only; the browser talks to /api/backend).
BACKEND_API_URL=http://localhost:8000
# Auth.js: a long random secret encrypting the session cookie (openssl rand -base64 33).
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Keycloak client (confidential; the secret stays on the server).
AUTH_KEYCLOAK_ID=pricing-web
AUTH_KEYCLOAK_SECRET=pricing-web-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:58080/realms/tunoo
